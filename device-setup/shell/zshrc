# claude -sf: away mode + Remote Control + skip permissions + /sf build loop.
# Any other invocation passes through to the real claude binary unchanged.
claude() {
  if [ "${1:-}" = "-lsf" ]; then
    shift
    "$HOME/.local/bin/claude-lsf" "$@"
  elif [ "${1:-}" = "-sf" ]; then
    shift
    # Keep the Mac awake for the life of this shell's claude run (same flags as away-mode).
    caffeinate -ims -w $$ >/dev/null 2>&1 &!
    command -v battery >/dev/null 2>&1 && battery maintain 70-80 >/dev/null 2>&1
    command claude --dangerously-skip-permissions \
      --remote-control "sf-${PWD:t}" \
      --name "sf-${PWD:t}" \
      "$@" "/sf"
  else
    command claude "$@"
  fi
}
