eval "$(fnm env --use-on-cd)"
gemini() {
    # Find the current version in the npx cache
    local package_json=$(find "$HOME/.npm/_npx" -maxdepth 5 -name "package.json" -path "*/@google/gemini-cli/package.json" -exec ls -t {} + 2>/dev/null | head -n 1)
    local old_version=""
    local installed_date=""
    if [[ -n "$package_json" && -f "$package_json" ]]; then
        old_version=$(grep '"version":' "$package_json" | head -n 1 | cut -d'"' -f4)
        installed_date=$(stat -f "%Sm" "$package_json" 2>/dev/null)
    fi

    local target_tag="latest"
    local boot_version="$old_version"

    # Handle tag selection
    local gemini_args=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --preview|--nightly|--stable)
                target_tag="${1#--}"
                [[ "$target_tag" == "stable" ]] && target_tag="latest"
                shift
                ;;
            *)
                gemini_args+=("$1")
                shift
                ;;
        esac
    done

    # Check for updates if interactive
    if [[ -t 1 ]]; then
        printf "gemini booting... (checking versions)\r"
        local info=$(npm show @google/gemini-cli --json 2>/dev/null)
        if [[ $? -eq 0 && -n "$info" ]]; then
            local latest_ver=$(echo "$info" | jq -r '."dist-tags".latest' 2>/dev/null)
            local preview_ver=$(echo "$info" | jq -r '."dist-tags".preview' 2>/dev/null)
            local nightly_ver=$(echo "$info" | jq -r '."dist-tags".nightly' 2>/dev/null)
            
            case "$target_tag" in
                preview) boot_version="$preview_ver" ;;
                nightly) boot_version="$nightly_ver" ;;
                *)       boot_version="$latest_ver"  ;;
            esac

            printf "\r\033[Kgemini versions:\n"
            for tag_pair in "stable:$latest_ver" "preview:$preview_ver" "nightly:$nightly_ver"; do
                local tag="${tag_pair%%:*}"
                local ver="${tag_pair#*:}"
                local rel_date=$(echo "$info" | jq -r ".time[\"$ver\"]" 2>/dev/null)
                
                # Format release date (macOS date command)
                local d="${rel_date%%.*}"
                [[ "$d" == "$rel_date" ]] && d="${rel_date%Z}"
                local fmt_rel_date=$(date -jf "%Y-%m-%dT%H:%M:%S" "$d" "+%B %d, %Y" 2>/dev/null || echo "$rel_date")
                
                local marker="  "
                local extra=""
                if [[ "$ver" == "$old_version" ]]; then
                    marker="* "
                    extra=" [installed: $installed_date]"
                fi
                printf "%s%-8s %-15s (Released: %s)%s\n" "$marker" "$tag" "$ver" "$fmt_rel_date" "$extra"
            done
            printf "\n"
        fi
    fi

    # Boot Gemini
    if [[ -n "$boot_version" ]]; then
        npx -y @google/gemini-cli@$boot_version "${gemini_args[@]}"
    else
        npx -y @google/gemini-cli "${gemini_args[@]}"
    fi
}


# Local user tools
