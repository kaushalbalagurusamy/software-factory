{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "minesweeper/claims.v1.json",
  "title": "Extracted claims (step 1 output: claims.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "brief", "lenses_applied", "claims"],
  "properties": {
    "schema_version": {"const": 1},
    "brief": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "lenses_applied": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "version", "why"],
        "properties": {"id": {"type": "string"}, "version": {"type": "string"}, "why": {"type": "string"}}
      }
    },
    "lenses_skipped": {"type": "array", "items": {"type": "string"}},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "text", "locator"],
        "properties": {
          "id": {"type": "string", "pattern": "^C-\\d{3,}$"},
          "kind": {"enum": ["requirement", "dependency", "metric", "rubric", "example", "assumption", "omission"]},
          "text": {"type": "string", "minLength": 3},
          "locator": {"type": "string", "description": "Brief line range, rubric item, or for an omission the required statement id <lens>.<statement>."},
          "pass": {"type": "integer", "minimum": 1, "description": "Discovery-loop pass that produced the claim."},
          "origin": {"type": "string", "description": "brief | finding id that reframed it | research/experiment path that surfaced it"}
        }
      }
    }
  }
}
